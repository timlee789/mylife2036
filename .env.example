# Copy to .env.local for local development. Never commit real values.

# Password for the single login. Required.
SITE_PASSWORD=change-me

# Long random text that signs the login cookie. Required. Make one with: openssl rand -hex 32
SESSION_SECRET=

# Postgres connection (Neon). Leave empty locally to use a file database in ./.pglite
# On Vercel the Neon integration sets this for you.
DATABASE_URL=
